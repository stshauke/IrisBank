{% extends 'base.html.twig' %}
{% block title %}{{ compte.typeLabel }}{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <a href="{{ path('app_comptes_list') }}" class="back-link">
            <i class="fas fa-arrow-left"></i> Mes comptes
        </a>
        <h1 class="page-title" style="margin-top: 8px;">{{ compte.typeLabel }}</h1>
        <p class="page-subtitle">{{ compte.iban }}</p>
    </div>
    {% if compte.isActif %}
    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
        <a href="{{ path('app_depot', {id: compte.id}) }}" class="btn btn-success">
            <i class="fas fa-arrow-down"></i> Dépôt
        </a>
        <a href="{{ path('app_retrait', {id: compte.id}) }}" class="btn btn-warning">
            <i class="fas fa-arrow-up"></i> Retrait
        </a>
        <a href="{{ path('app_virement') }}" class="btn btn-primary">
            <i class="fas fa-paper-plane"></i> Virement
        </a>
    </div>
    {% endif %}
</div>

{# ===== CARTES VIRTUELLES ===== #}
<div class="card cartes-section">
    <div class="card-header">
        <div>
            <h3 class="card-title"><i class="fas fa-credit-card" style="color: var(--iris);"></i> Cartes virtuelles</h3>
            <p style="font-size: 13px; color: var(--text-3); margin: 0;">Générez des cartes éphémères Visa ou Mastercard</p>
        </div>
        {% if compte.isActif %}
        <div style="display: flex; gap: 8px;">
            <form method="post" action="{{ path('app_carte_generer', {id: compte.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('carte_generer_' ~ compte.id) }}">
                <input type="hidden" name="type" value="visa">
                <button type="submit" class="btn btn-outline btn-sm">
                    <span class="visa-logo-sm">VISA</span> Générer
                </button>
            </form>
            <form method="post" action="{{ path('app_carte_generer', {id: compte.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('carte_generer_' ~ compte.id) }}">
                <input type="hidden" name="type" value="mastercard">
                <button type="submit" class="btn btn-outline btn-sm">
                    <span class="mc-logo-sm"><span class="mc-left"></span><span class="mc-right"></span></span> Générer
                </button>
            </form>
        </div>
        {% endif %}
    </div>

    {% set cartesActives = compte.cartesVirtuelles|filter(c => c.isActive) %}
    {% if cartesActives is empty %}
    <div class="empty-state" style="padding: 28px;">
        <div class="empty-icon" style="font-size: 32px;"><i class="fas fa-credit-card"></i></div>
        <div class="empty-text" style="margin-bottom: 0;">Aucune carte virtuelle active — générez-en une ci-dessus</div>
    </div>
    {% else %}
    <div class="cartes-grid-virt">
        {% for carte in cartesActives %}

        {# Flip card — checkbox trick, no JS needed #}
        <div class="virt-card-wrapper">
            <input type="checkbox" id="flip-{{ carte.id }}" class="virt-flip-toggle">

            <div class="virt-card-flipper">

                {# FACE AVANT #}
                <div class="virt-card virt-card--{{ carte.type }} virt-card-face virt-card-face--front">
                    <div class="virt-card__top">
                        <div class="virt-card__chip">
                            <div class="chip-line"></div>
                            <div class="chip-line"></div>
                            <div class="chip-line"></div>
                        </div>
                        {% if carte.type == 'visa' %}
                            <span class="virt-card__logo virt-card__logo--visa">VISA</span>
                        {% else %}
                            <span class="virt-card__logo virt-card__logo--mc">
                                <span class="mc-circle mc-circle--left"></span>
                                <span class="mc-circle mc-circle--right"></span>
                            </span>
                        {% endif %}
                    </div>
                    <div class="virt-card__number">{{ carte.numeroMasque }}</div>
                    <div class="virt-card__bottom">
                        <div>
                            <div class="virt-card__meta-label">Expire</div>
                            <div class="virt-card__meta-value">{{ carte.dateExpirationFormatee }}</div>
                        </div>
                        <div style="margin-left: auto;">
                            <span class="status-badge status-actif" style="font-size: 10px;">Active</span>
                        </div>
                    </div>
                    <label for="flip-{{ carte.id }}" class="btn btn-outline btn-sm virt-card-face__btn-flip">
                        <i class="fas fa-eye"></i> Voir infos
                    </label>
                </div>

                {# FACE ARRIÈRE #}
                <div class="virt-card virt-card--{{ carte.type }} virt-card-face virt-card-face--back">
                    <div class="virt-card__stripe"></div>
                    <div class="virt-card__back-content">
                        <div class="virt-card__back-row">
                            <span class="virt-card__meta-label">Numéro complet</span>
                            <span class="virt-card__number" style="font-size: 13px;">{{ carte.numero }}</span>
                        </div>
                        <div class="virt-card__back-row">
                            <span class="virt-card__meta-label">Date d'expiration</span>
                            <span class="virt-card__meta-value">{{ carte.dateExpirationFormatee }}</span>
                        </div>
                        <div class="virt-card__back-row">
                            <span class="virt-card__meta-label">CVV</span>
                            <span class="virt-card__meta-value virt-card__cvv">{{ carte.cvv }}</span>
                        </div>
                    </div>
                    <label for="flip-{{ carte.id }}" class="btn btn-outline btn-sm virt-card-face__btn-flip">
                        <i class="fas fa-eye-slash"></i> Masquer
                    </label>
                </div>

            </div>{# /flipper #}

            {# Actions sous la carte #}
            <div class="virt-card-actions">
                <a href="{{ path('app_carte_transactions', {id: compte.id, carteId: carte.id}) }}"
                   class="btn btn-outline btn-sm" style="flex: 1; justify-content: center;">
                    <i class="fas fa-list-alt"></i> Transactions
                </a>
                <form method="post" action="{{ path('app_carte_resilier', {id: compte.id, carteId: carte.id}) }}"
                      onsubmit="return confirm('Résilier cette carte définitivement ?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('carte_resilier_' ~ carte.id) }}">
                    <button type="submit" class="btn btn-danger btn-sm">
                        <i class="fas fa-times-circle"></i> Résilier
                    </button>
                </form>
            </div>
        </div>{# /wrapper #}

        {% endfor %}
    </div>
    {% endif %}
</div>

<div style="display: grid; grid-template-columns: 1fr 2fr; gap: 24px; align-items: start;">
    <div>
        <div class="compte-card {{ compte.type }}" style="margin-bottom: 20px;">
            <div class="badge">
                <i class="fas fa-{% if compte.type == 'courant' %}credit-card{% elseif compte.type == 'livret_a' %}piggy-bank{% else %}home{% endif %}"></i>
                {{ compte.typeLabel }}
            </div>
            <div class="compte-solde">{{ compte.soldeFloat|number_format(2, ',', ' ') }} €</div>
            <div class="compte-iban">{{ compte.iban }}</div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Informations</h3>
            </div>
            <table class="info-table">
                <tr>
                    <td class="info-label">Statut</td>
                    <td class="info-value">
                        <span class="status-badge {{ compte.isActif ? 'status-actif' : 'status-bloque' }}">
                            <i class="fas fa-{{ compte.isActif ? 'check-circle' : 'lock' }}"></i>
                            {{ compte.isActif ? 'Actif' : 'Bloqué' }}
                        </span>
                    </td>
                </tr>
                <tr>
                    <td class="info-label">Type</td>
                    <td class="info-value">{{ compte.typeLabel }}</td>
                </tr>
                <tr>
                    <td class="info-label">Solde</td>
                    <td class="info-value" style="font-family: 'Space Mono', monospace;">
                        <span class="{{ compte.soldeFloat >= 0 ? 'amount-positive' : 'amount-negative' }}">
                            {{ compte.soldeFloat|number_format(2, ',', ' ') }} €
                        </span>
                    </td>
                </tr>
                <tr>
                    <td class="info-label">Ouvert le</td>
                    <td class="info-value">{{ compte.createdAt|date('d/m/Y') }}</td>
                </tr>
            </table>

            {% if compte.soldeFloat == 0 and compte.isActif %}
            <div class="divider"></div>
            <form method="post" action="{{ path('app_comptes_delete', {id: compte.id}) }}"
                  onsubmit="return confirm('⚠️ Êtes-vous sûr de vouloir supprimer ce compte ? Cette action est irréversible.')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_compte_' ~ compte.id) }}">
                <button type="submit" class="btn btn-danger w-full" style="justify-content: center;">
                    <i class="fas fa-trash"></i> Supprimer le compte
                </button>
            </form>
            <p style="font-size: 11px; color: var(--text-3); margin-top: 8px; text-align: center;">Possible uniquement si solde = 0€</p>
            {% endif %}
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Historique des transactions</h3>
            <span style="font-size: 13px; color: var(--text-3);">{{ transactions|length }} opération{{ transactions|length > 1 ? 's' : '' }}</span>
        </div>

        {% if transactions is empty %}
        <div class="empty-state" style="padding: 32px;">
            <div class="empty-icon" style="font-size: 36px;"><i class="fas fa-history"></i></div>
            <div class="empty-text" style="margin-bottom: 0;">Aucune transaction sur ce compte</div>
        </div>
        {% else %}
        {% for tx in transactions %}
        <div class="tx-item">
            <div class="tx-icon {{ tx.isCredit ? 'credit' : 'debit' }}">
                <i class="fas fa-{% if tx.type == 'depot' %}arrow-down{% elseif tx.type == 'retrait' %}arrow-up{% else %}exchange-alt{% endif %}"></i>
            </div>
            <div class="tx-info">
                <div class="tx-label">{{ tx.libelle ?? tx.typeLabel }}</div>
                <div class="tx-date">
                    {{ tx.typeLabel }}
                    {% if tx.compteSource and tx.compteSource.id != compte.id %}
                     · De {{ tx.compteSource.iban }}
                    {% elseif tx.compteDestinataire and tx.compteDestinataire.id != compte.id %}
                     · Vers {{ tx.compteDestinataire.iban }}
                    {% endif %}
                    · {{ tx.createdAt|date('d/m/Y à H:i') }}
                </div>
            </div>
            <div class="tx-amount {{ tx.isCredit ? 'amount-credit' : 'amount-debit' }}">
                {{ tx.isCredit ? '+' : '-' }}{{ tx.montantFloat|number_format(2, ',', ' ') }} €
            </div>
        </div>
        {% endfor %}
        {% endif %}
    </div>
</div>
{% endblock %}
