{% extends 'base.html.twig' %}
{% block title %}{{ compte.typeLabel }}{% endblock %}

{% block body %}

{# ── En-tête ── #}
<div class="page-header">
    <div>
        <a href="{{ path('app_comptes_list') }}"
           style="color:var(--t2); text-decoration:none; font-size:14px; display:inline-flex; align-items:center; gap:6px;">
            <i class="fas fa-arrow-left"></i> Mes comptes
        </a>
        <h1 class="page-title" style="margin-top:8px;">{{ compte.typeLabel }}</h1>
        <p class="page-subtitle">{{ compte.iban }}</p>
    </div>

    {% if compte.isActif %}
    <div style="display:flex; gap:10px; flex-wrap:wrap;">
        <a href="{{ path('app_depot',   {id: compte.id}) }}" class="btn btn-success">
            <i class="fas fa-arrow-down"></i> Dépôt
        </a>
        <a href="{{ path('app_retrait', {id: compte.id}) }}" class="btn btn-warning">
            <i class="fas fa-arrow-up"></i> Retrait
        </a>
        <a href="{{ path('app_virement') }}" class="btn btn-primary">
            <i class="fas fa-paper-plane"></i> Virement
        </a>
    </div>
    {% endif %}
</div>

<div style="display:grid; grid-template-columns:1fr 2fr; gap:24px; align-items:start;">

    {# ══ COLONNE GAUCHE : infos du compte ══ #}
    <div>

        {# Carte visuelle #}
        <div class="compte-card {{ compte.type }}" style="margin-bottom:18px;">
            <div class="badge">
                <i class="fas fa-{% if compte.type == 'courant' %}credit-card{% elseif compte.type == 'livret_a' %}piggy-bank{% else %}home{% endif %}"></i>
                {{ compte.typeLabel }}
            </div>
            <div class="compte-solde">{{ compte.soldeFloat|number_format(2, ',', ' ') }} €</div>
            <div class="compte-iban">{{ compte.iban }}</div>
        </div>

        {# Informations #}
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Informations</h3>
            </div>

            <table style="width:100%;">
                <tr style="border-bottom:1px solid var(--border);">
                    <td style="padding:10px 0; font-size:13px; color:var(--t2);">Statut</td>
                    <td style="padding:10px 0; text-align:right;">
                        <span class="status-badge {{ compte.isActif ? 'status-actif' : 'status-bloque' }}">
                            <i class="fas fa-{{ compte.isActif ? 'check-circle' : 'lock' }}"></i>
                            {{ compte.isActif ? 'Actif' : 'Bloqué' }}
                        </span>
                    </td>
                </tr>
                <tr style="border-bottom:1px solid var(--border);">
                    <td style="padding:10px 0; font-size:13px; color:var(--t2);">Type</td>
                    <td style="padding:10px 0; text-align:right; font-size:14px; font-weight:600; color:var(--t1);">
                        {{ compte.typeLabel }}
                    </td>
                </tr>
                <tr style="border-bottom:1px solid var(--border);">
                    <td style="padding:10px 0; font-size:13px; color:var(--t2);">Solde</td>
                    <td style="padding:10px 0; text-align:right; font-family:'Space Mono',monospace;
                               font-size:14px; font-weight:700;
                               color:{{ compte.soldeFloat > 0 ? '#059669' : (compte.soldeFloat < 0 ? '#dc2626' : 'var(--t2)') }};">
                        {{ compte.soldeFloat|number_format(2, ',', ' ') }} €
                    </td>
                </tr>
                <tr>
                    <td style="padding:10px 0; font-size:13px; color:var(--t2);">Ouvert le</td>
                    <td style="padding:10px 0; text-align:right; font-size:13px; color:var(--t1);">
                        {{ compte.createdAt|date('d/m/Y') }}
                    </td>
                </tr>
            </table>

            <div class="divider"></div>

            {#
              ══════════════════════════════════════════
              ZONE SUPPRESSION — RÉSERVÉE À L'ADMIN
              Le client voit uniquement un message info.
              ══════════════════════════════════════════
            #}
            <div style="background:#eff6ff; border:1px solid #bfdbfe; border-radius:var(--rsm);
                        padding:14px 16px; display:flex; gap:10px; align-items:flex-start;">
                <i class="fas fa-info-circle" style="color:#3b82f6; margin-top:2px; flex-shrink:0;"></i>
                <div>
                    <div style="font-size:13px; font-weight:700; color:#1e40af; margin-bottom:3px;">
                        Fermeture de compte
                    </div>
                    <div style="font-size:12px; color:#1d4ed8; line-height:1.5;">
                        La suppression d'un compte est effectuée uniquement par un
                        <strong>administrateur</strong>. Contactez votre conseiller si vous
                        souhaitez fermer ce compte.
                    </div>
                </div>
            </div>

        </div>
    </div>

    {# ══ COLONNE DROITE : historique des transactions ══ #}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Historique des transactions</h3>
            <span style="font-size:13px; color:var(--t2);">
                {{ transactions|length }} opération{{ transactions|length > 1 ? 's' : '' }}
            </span>
        </div>

        {% if transactions is empty %}
        <div class="empty-state" style="padding:40px 24px;">
            <div class="empty-icon"><i class="fas fa-history"></i></div>
            <div class="empty-title">Aucune transaction</div>
            <div class="empty-text" style="margin-bottom:0;">
                Les opérations sur ce compte apparaîtront ici.
            </div>
        </div>

        {% else %}
        {% for tx in transactions %}
        <div class="tx-item">
            <div class="tx-icon {{ tx.isCredit ? 'credit' : 'debit' }}">
                <i class="fas fa-{% if tx.type == 'depot' %}arrow-down{% elseif tx.type == 'retrait' %}arrow-up{% else %}exchange-alt{% endif %}"></i>
            </div>
            <div class="tx-info">
                <div class="tx-label">{{ tx.libelle ?? tx.typeLabel }}</div>
                <div class="tx-date">
                    {{ tx.typeLabel }}
                    {% if tx.compteSource and tx.compteSource.id != compte.id %}
                        · De {{ tx.compteSource.iban }}
                    {% elseif tx.compteDestinataire and tx.compteDestinataire.id != compte.id %}
                        · Vers {{ tx.compteDestinataire.iban }}
                    {% endif %}
                    · {{ tx.createdAt|date('d/m/Y à H:i') }}
                </div>
            </div>
            <div class="tx-amount {{ tx.isCredit ? 'amount-credit' : 'amount-debit' }}">
                {{ tx.isCredit ? '+' : '−' }}{{ tx.montantFloat|number_format(2, ',', ' ') }} €
            </div>
        </div>
        {% endfor %}
        {% endif %}

    </div>
</div>

{% endblock %}
