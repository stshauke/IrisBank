{% extends 'base.html.twig' %}
{% block title %}Retrait{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <a href="{{ path('app_comptes_show', {id: compte.id}) }}" style="color: #94a3b8; text-decoration: none; font-size: 14px;">
            <i class="fas fa-arrow-left"></i> Retour au compte
        </a>
        <h1 class="page-title" style="margin-top: 8px;">Effectuer un retrait</h1>
        <p class="page-subtitle">{{ compte.typeLabel }} — {{ compte.iban }}</p>
    </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: start; max-width: 900px;">
    <div class="form-wrapper">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px; padding-bottom: 20px; border-bottom: 1px solid #1e293b;">
            <div style="width: 48px; height: 48px; background: rgba(245,158,11,0.15); border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 22px; color: #fcd34d;">
                <i class="fas fa-arrow-up"></i>
            </div>
            <div>
                <div style="font-size: 16px; font-weight: 700;">Retrait</div>
                <div style="font-size: 13px; color: #64748b;">Min. 1€ — Max. 1 000€</div>
            </div>
        </div>

        {{ form_start(form) }}

        <div class="form-group">
            {{ form_label(form.montant) }}
            {{ form_widget(form.montant, {attr: {class: 'ib-input', style: 'font-family: Space Mono, monospace; font-size: 20px; font-weight: 700; text-align: center;'}}) }}
            {{ form_errors(form.montant) }}
        </div>

        <div class="form-group">
            {{ form_label(form.libelle) }}
            {{ form_widget(form.libelle, {attr: {class: 'ib-input'}}) }}
            {{ form_errors(form.libelle) }}
        </div>

        <div style="background: rgba(245,158,11,0.1); border: 1px solid rgba(245,158,11,0.2); border-radius: 10px; padding: 12px; margin-bottom: 20px; font-size: 13px; color: #fcd34d;">
            <i class="fas fa-info-circle"></i>
            Solde disponible : <strong>{{ compte.soldeFloat|number_format(2, ',', ' ') }} €</strong>
        </div>

        <button type="submit" class="btn btn-warning w-full btn-lg" style="justify-content: center;">
            <i class="fas fa-check"></i> Confirmer le retrait
        </button>

        {{ form_end(form) }}
    </div>

    <div class="compte-card {{ compte.type }}">
        <div class="badge"><i class="fas fa-credit-card"></i> {{ compte.typeLabel }}</div>
        <div style="font-size: 13px; color: #64748b; margin-top: 12px;">Solde actuel</div>
        <div class="compte-solde">{{ compte.soldeFloat|number_format(2, ',', ' ') }} €</div>
        <div class="compte-iban">{{ compte.iban }}</div>
    </div>
</div>

<style>
.ib-input { width: 100%; background: #1a2235; border: 1px solid #2d3a4f; border-radius: 10px; padding: 12px 16px; color: #f8fafc; font-family: 'Sora', sans-serif; font-size: 14px; transition: all 0.25s ease; }
.ib-input:focus { outline: none; border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,0.15); }
</style>
{% endblock %}
