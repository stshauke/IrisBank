{% extends 'base.html.twig' %}
{% block title %}Virement{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1 class="page-title">Effectuer un virement</h1>
        <p class="page-subtitle">Entre vos comptes ou vers un autre client via IBAN</p>
    </div>
</div>

<div class="form-layout-centered">
    <div class="form-wrapper">
        <div class="form-card-header">
            <div class="form-card-icon form-card-icon-primary">
                <i class="fas fa-paper-plane"></i>
            </div>
            <div>
                <div class="form-card-title">Virement bancaire</div>
                <div class="form-card-subtitle">Sécurisé et instantané</div>
            </div>
        </div>

        {{ form_start(form) }}

        <div class="form-group">
            {{ form_label(form.compteSource) }}
            {{ form_widget(form.compteSource, {attr: {class: 'ib-input'}}) }}
            {{ form_errors(form.compteSource) }}
        </div>

        <div class="section-box">
            <div class="section-box-label">Destinataire</div>

            <div class="form-group">
                {{ form_label(form.compteDestinataire) }}
                {{ form_widget(form.compteDestinataire, {attr: {class: 'ib-input'}}) }}
                {{ form_errors(form.compteDestinataire) }}
            </div>

            <div class="or-divider">OU</div>

            <div class="form-group" style="margin-bottom: 0;">
                {{ form_label(form.ibanDestinataire) }}
                {{ form_widget(form.ibanDestinataire, {attr: {class: 'ib-input', style: 'font-family: Space Mono, monospace;'}}) }}
                {{ form_errors(form.ibanDestinataire) }}
            </div>
        </div>

        <div class="form-group">
            {{ form_label(form.montant) }}
            {{ form_widget(form.montant, {attr: {class: 'ib-input', style: 'font-family: Space Mono, monospace; font-size: 20px; font-weight: 700; text-align: center;'}}) }}
            {{ form_errors(form.montant) }}
        </div>

        <div class="form-group">
            {{ form_label(form.libelle) }}
            {{ form_widget(form.libelle, {attr: {class: 'ib-input'}}) }}
        </div>

        <button type="submit" class="btn btn-primary w-full btn-lg" style="justify-content: center;">
            <i class="fas fa-paper-plane"></i> Envoyer le virement
        </button>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
