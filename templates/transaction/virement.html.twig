{% extends 'base.html.twig' %}
{% block title %}Virement{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1 class="page-title">Effectuer un virement</h1>
        <p class="page-subtitle">Entre vos comptes ou vers un autre client via IBAN</p>
    </div>
</div>

<div style="max-width: 640px;">
    <div class="form-wrapper">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px; padding-bottom: 20px; border-bottom: 1px solid #1e293b;">
            <div style="width: 48px; height: 48px; background: rgba(99,102,241,0.15); border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 22px; color: #818cf8;">
                <i class="fas fa-paper-plane"></i>
            </div>
            <div>
                <div style="font-size: 16px; font-weight: 700;">Virement bancaire</div>
                <div style="font-size: 13px; color: #64748b;">Sécurisé et instantané</div>
            </div>
        </div>

        {{ form_start(form) }}

        <div class="form-group">
            {{ form_label(form.compteSource) }}
            {{ form_widget(form.compteSource, {attr: {class: 'ib-input'}}) }}
            {{ form_errors(form.compteSource) }}
        </div>

        <div style="background: #1a2235; border: 1px solid #2d3a4f; border-radius: 10px; padding: 16px; margin-bottom: 20px;">
            <div style="font-size: 12px; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px;">Destinataire</div>
            
            <div class="form-group">
                {{ form_label(form.compteDestinataire) }}
                {{ form_widget(form.compteDestinataire, {attr: {class: 'ib-input'}}) }}
                {{ form_errors(form.compteDestinataire) }}
            </div>

            <div style="display: flex; align-items: center; gap: 12px; margin: 12px 0;">
                <div style="flex: 1; height: 1px; background: #2d3a4f;"></div>
                <div style="font-size: 12px; color: #64748b; font-weight: 600;">OU</div>
                <div style="flex: 1; height: 1px; background: #2d3a4f;"></div>
            </div>

            <div class="form-group" style="margin-bottom: 0;">
                {{ form_label(form.ibanDestinataire) }}
                {{ form_widget(form.ibanDestinataire, {attr: {class: 'ib-input', style: 'font-family: Space Mono, monospace;'}}) }}
                {{ form_errors(form.ibanDestinataire) }}
            </div>
        </div>

        <div class="form-group">
            {{ form_label(form.montant) }}
            {{ form_widget(form.montant, {attr: {class: 'ib-input', style: 'font-family: Space Mono, monospace; font-size: 20px; font-weight: 700; text-align: center;'}}) }}
            {{ form_errors(form.montant) }}
        </div>

        <div class="form-group">
            {{ form_label(form.libelle) }}
            {{ form_widget(form.libelle, {attr: {class: 'ib-input'}}) }}
        </div>

        <button type="submit" class="btn btn-primary w-full btn-lg" style="justify-content: center;">
            <i class="fas fa-paper-plane"></i> Envoyer le virement
        </button>

        {{ form_end(form) }}
    </div>
</div>

<style>
.ib-input { width: 100%; background: #1a2235; border: 1px solid #2d3a4f; border-radius: 10px; padding: 12px 16px; color: #f8fafc; font-family: 'Sora', sans-serif; font-size: 14px; transition: all 0.25s ease; }
.ib-input:focus { outline: none; border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,0.15); }
</style>
{% endblock %}
