{% extends 'base.html.twig' %}
{% block title %}Historique{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1 class="page-title">Historique des transactions</h1>
        <p class="page-subtitle">{{ transactions|length }} transaction{{ transactions|length > 1 ? 's' : '' }}</p>
    </div>
</div>

{% if transactions is empty %}
<div class="empty-state empty-state-card">
    <div class="empty-icon"><i class="fas fa-history"></i></div>
    <div class="empty-title">Aucune transaction</div>
    <div class="empty-text">Vos opérations bancaires apparaîtront ici.</div>
</div>
{% else %}
<div class="table-container history-table">
    <table>
        <thead>
            <tr>
                <th>Type</th>
                <th>Libellé</th>
                <th>Compte</th>
                <th>Date</th>
                <th style="text-align: right;">Montant</th>
            </tr>
        </thead>
        <tbody>
        {% for tx in transactions %}
        <tr>
            <td data-label="Type">
                <div class="history-type">
                    <div class="tx-icon {{ tx.isCredit ? 'credit' : 'debit' }} history-type-icon">
                        <i class="fas fa-{% if tx.type == 'depot' %}arrow-down{% elseif tx.type == 'retrait' %}arrow-up{% else %}exchange-alt{% endif %}"></i>
                    </div>
                    <span class="history-type-label {{ tx.isCredit ? 'amount-credit' : 'amount-debit' }}">
                        {{ tx.typeLabel }}
                    </span>
                </div>
            </td>

            <td data-label="Libellé">
                <div class="history-label">
                    {{ tx.libelle ?? '—' }}
                </div>
            </td>

            <td data-label="Compte">
                <div class="history-account">
                    {% if tx.compteSource and tx.compteDestinataire %}
                        <div class="history-account-line" title="{{ tx.compteSource.iban }} → {{ tx.compteDestinataire.iban }}">
                            <span>{{ tx.compteSource.iban|slice(0, 8) }}…{{ tx.compteSource.iban|slice(-4) }}</span>
                            <i class="fas fa-arrow-right history-arrow"></i>
                            <span>{{ tx.compteDestinataire.iban|slice(0, 8) }}…{{ tx.compteDestinataire.iban|slice(-4) }}</span>
                        </div>
                    {% elseif tx.compteSource %}
                        <div class="history-account-line" title="{{ tx.compteSource.iban }}">
                            {{ tx.compteSource.iban|slice(0, 8) }}…{{ tx.compteSource.iban|slice(-4) }}
                        </div>
                    {% elseif tx.compteDestinataire %}
                        <div class="history-account-line" title="{{ tx.compteDestinataire.iban }}">
                            {{ tx.compteDestinataire.iban|slice(0, 8) }}…{{ tx.compteDestinataire.iban|slice(-4) }}
                        </div>
                    {% else %}
                        <div class="history-account-line">—</div>
                    {% endif %}
                </div>
            </td>

            <td data-label="Date" class="history-date">
                {{ tx.createdAt|date('d/m/Y à H:i') }}
            </td>

            <td data-label="Montant" class="history-amount {{ tx.isCredit ? 'amount-credit' : 'amount-debit' }}">
                {{ tx.isCredit ? '+' : '-' }}{{ tx.montantFloat|number_format(2, ',', ' ') }} €
            </td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}
{% endblock %}
