{% extends 'base.html.twig' %}
{% block title %}Dépôt{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <a href="{{ path('app_comptes_show', {id: compte.id}) }}" class="back-link">
            <i class="fas fa-arrow-left"></i> Retour au compte
        </a>
        <h1 class="page-title" style="margin-top: 8px;">Effectuer un dépôt</h1>
        <p class="page-subtitle">{{ compte.typeLabel }} — {{ compte.iban }}</p>
    </div>
</div>

<div class="tx-form-layout">
    <div class="form-wrapper">
        <div class="form-card-header">
            <div class="form-card-icon form-card-icon-success">
                <i class="fas fa-arrow-down"></i>
            </div>
            <div>
                <div class="form-card-title">Dépôt</div>
                <div class="form-card-subtitle">Minimum 1€</div>
            </div>
        </div>

        {{ form_start(form) }}

        <div class="form-group">
            {{ form_label(form.montant) }}
            {{ form_widget(form.montant, {attr: {class: 'ib-input', style: 'font-family: Space Mono, monospace; font-size: 20px; font-weight: 700; text-align: center;'}}) }}
            {{ form_errors(form.montant) }}
        </div>

        <div class="form-group">
            {{ form_label(form.libelle) }}
            {{ form_widget(form.libelle, {attr: {class: 'ib-input'}}) }}
            {{ form_errors(form.libelle) }}
        </div>

        <button type="submit" class="btn btn-success w-full btn-lg" style="justify-content: center;">
            <i class="fas fa-check"></i> Confirmer le dépôt
        </button>

        {{ form_end(form) }}
    </div>

    <div class="compte-card {{ compte.type }}">
        <div class="badge">
            <i class="fas fa-{% if compte.type == 'courant' %}credit-card{% elseif compte.type == 'livret_a' %}piggy-bank{% else %}home{% endif %}"></i>
            {{ compte.typeLabel }}
        </div>
        <div class="solde-label">Solde actuel</div>
        <div class="compte-solde">{{ compte.soldeFloat|number_format(2, ',', ' ') }} €</div>
        <div class="compte-iban">{{ compte.iban }}</div>
    </div>
</div>
{% endblock %}
