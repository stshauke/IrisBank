{% extends 'base.html.twig' %}
{% block title %}Transactions — Carte {{ carte.type|upper }}{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <a href="{{ path('app_comptes_show', {id: compte.id}) }}" class="back-link">
            <i class="fas fa-arrow-left"></i> {{ compte.typeLabel }}
        </a>
        <h1 class="page-title" style="margin-top: 8px;">
            Transactions de la carte
        </h1>
        <p class="page-subtitle">{{ carte.numeroMasque }}</p>
    </div>
</div>

<div style="display: grid; grid-template-columns: 280px 1fr; gap: 24px; align-items: start;">

    {# Mini carte #}
    <div class="virt-card virt-card--{{ carte.type }}" style="cursor: default;">
        <div class="virt-card__top">
            <div class="virt-card__chip">
                <div class="chip-line"></div>
                <div class="chip-line"></div>
                <div class="chip-line"></div>
            </div>
            {% if carte.type == 'visa' %}
                <span class="virt-card__logo virt-card__logo--visa">VISA</span>
            {% else %}
                <span class="virt-card__logo virt-card__logo--mc">
                    <span class="mc-circle mc-circle--left"></span>
                    <span class="mc-circle mc-circle--right"></span>
                </span>
            {% endif %}
        </div>
        <div class="virt-card__number">{{ carte.numeroMasque }}</div>
        <div class="virt-card__bottom">
            <div>
                <div class="virt-card__meta-label">Expire</div>
                <div class="virt-card__meta-value">{{ carte.dateExpirationFormatee }}</div>
            </div>
            <div>
                <div class="virt-card__meta-label">Statut</div>
                <div class="virt-card__meta-value" style="font-size: 11px;">{{ carte.isActive ? 'Active' : 'Résiliée' }}</div>
            </div>
        </div>
    </div>

    {# Transactions #}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Historique</h3>
            <span style="font-size: 13px; color: var(--text-3);">{{ carte.transactions|length }} opération{{ carte.transactions|length > 1 ? 's' : '' }}</span>
        </div>

        {% if carte.transactions is empty %}
        <div class="empty-state" style="padding: 32px;">
            <div class="empty-icon" style="font-size: 36px;"><i class="fas fa-receipt"></i></div>
            <div class="empty-text" style="margin-bottom: 0;">Aucune transaction sur cette carte</div>
        </div>
        {% else %}
            {% for tx in carte.transactions %}
            <div class="tx-item">
                <div class="tx-icon {{ tx.isCredit ? 'credit' : 'debit' }}">
                    <i class="fas fa-{% if tx.type == 'depot' %}arrow-down{% elseif tx.type == 'retrait' %}arrow-up{% else %}exchange-alt{% endif %}"></i>
                </div>
                <div class="tx-info">
                    <div class="tx-label">{{ tx.libelle ?? tx.typeLabel }}</div>
                    <div class="tx-date">{{ tx.typeLabel }} · {{ tx.createdAt|date('d/m/Y à H:i') }}</div>
                </div>
                <div class="tx-amount {{ tx.isCredit ? 'amount-credit' : 'amount-debit' }}">
                    {{ tx.isCredit ? '+' : '-' }}{{ tx.montantFloat|number_format(2, ',', ' ') }} €
                </div>
            </div>
            {% endfor %}
        {% endif %}
    </div>
</div>
{% endblock %}
