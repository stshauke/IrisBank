{% extends 'base.html.twig' %}
{% block title %}Nouveau mot de passe{% endblock %}
{% block body_class %}auth-page{% endblock %}

{% block body %}
<div class="auth-box">
    <div class="auth-logo">
        <div class="logo-icon"><i class="fas fa-eye"></i></div>
        <div class="brand">IrisBank</div>
    </div>

    <h2 class="auth-title">Nouveau mot de passe</h2>
    <p class="auth-subtitle">Choisissez un mot de passe fort : min. 8 caractères, 1 majuscule, 1 chiffre.</p>

    {{ form_start(form) }}

    <div class="form-group">
        {{ form_label(form.newPassword.first) }}
        <div class="password-field">
            {{ form_widget(form.newPassword.first, {attr: {id: 'pwd_reset_1'}}) }}
            <button type="button" class="password-toggle" onclick="togglePassword(this)" aria-label="Afficher/masquer">
                <i class="fas fa-eye"></i>
            </button>
        </div>
        {{ form_errors(form.newPassword.first) }}
    </div>

    <div class="form-group">
        {{ form_label(form.newPassword.second) }}
        <div class="password-field">
            {{ form_widget(form.newPassword.second, {attr: {id: 'pwd_reset_2'}}) }}
            <button type="button" class="password-toggle" onclick="togglePassword(this)" aria-label="Afficher/masquer">
                <i class="fas fa-eye"></i>
            </button>
        </div>
        {{ form_errors(form.newPassword.second) }}
    </div>

    <button type="submit" class="btn btn-primary w-full btn-lg auth-submit">
        <i class="fas fa-shield-alt"></i> Réinitialiser le mot de passe
    </button>

    {{ form_end(form) }}
</div>

<script>
function togglePassword(btn) {
    const input = btn.previousElementSibling;
    const icon = btn.querySelector('i');
    if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'fas fa-eye-slash';
    } else {
        input.type = 'password';
        icon.className = 'fas fa-eye';
    }
}
</script>
{% endblock %}
