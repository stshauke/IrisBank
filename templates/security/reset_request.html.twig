{% extends 'base.html.twig' %}
{% block title %}Mot de passe oublié{% endblock %}
{% block body_class %}auth-page{% endblock %}

{% block body %}
<div class="auth-box">
    <div class="auth-logo">
        <div class="logo-icon"><i class="fas fa-eye"></i></div>
        <div class="brand">IrisBank</div>
        <div class="tagline">Réinitialisation du mot de passe</div>
    </div>

    <h2 class="auth-title">Mot de passe oublié ?</h2>
    <p class="auth-subtitle">Entrez votre email et nous vous enverrons un lien de réinitialisation.</p>

    {{ form_start(form) }}

    <div class="form-group">
        {{ form_label(form.email) }}
        {{ form_widget(form.email) }}
        {{ form_errors(form.email) }}
    </div>

    <button type="submit" class="btn btn-primary w-full btn-lg auth-submit">
        <i class="fas fa-paper-plane"></i> Envoyer le lien
    </button>

    {{ form_end(form) }}

    <div class="auth-link">
        <a href="{{ path('app_login') }}"><i class="fas fa-arrow-left"></i> Retour à la connexion</a>
    </div>
</div>
{% endblock %}
