{% extends 'base.html.twig' %}
{% block title %}Connexion{% endblock %}
{% block body_class %}auth-page{% endblock %}

{% block body %}
<div class="auth-box">
    <div class="auth-logo">
        <div class="logo-icon"><i class="fas fa-eye"></i></div>
        <div class="brand" style="background: linear-gradient(135deg, #f8fafc, #818cf8); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">IrisBank</div>
        <div class="tagline">Votre banque en ligne de confiance</div>
    </div>

    <h2 class="auth-title">Bon retour ! 👋</h2>
    <p class="auth-subtitle">Connectez-vous à votre espace personnel</p>

    {% if error %}
    <div class="flash flash-error">
        <i class="fas fa-exclamation-circle"></i>
        {{ error.messageKey|trans(error.messageData, 'security') }}
        <button class="flash-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>
    </div>
    {% endif %}

    <form method="post" action="{{ path('app_login') }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <div class="form-group">
            <label for="email">Adresse email</label>
            <input type="email" id="email" name="email" value="{{ last_username }}" 
                   placeholder="votre@email.fr" autocomplete="email" required
                   style="width:100%; background: #1a2235; border: 1px solid #2d3a4f; border-radius: 10px; padding: 12px 16px; color: #f8fafc; font-family: Sora, sans-serif; font-size: 14px;">
        </div>

        <div class="form-group" style="position: relative;">
            <label for="password">Mot de passe</label>
            <input type="password" id="password" name="password" 
                   placeholder="••••••••" autocomplete="current-password" required
                   style="width:100%; background: #1a2235; border: 1px solid #2d3a4f; border-radius: 10px; padding: 12px 48px 12px 16px; color: #f8fafc; font-family: Sora, sans-serif; font-size: 14px;">
            <button type="button" onclick="togglePassword('password')" 
                    style="position: absolute; right: 14px; bottom: 12px; background: none; border: none; color: #64748b; cursor: pointer; font-size: 16px;">
                <i class="fas fa-eye" id="toggleIcon"></i>
            </button>
        </div>

        <div style="display:flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
            <label style="display:flex; align-items:center; gap:8px; font-size:13px; color:#94a3b8; cursor:pointer; font-weight: 400; text-transform: none; letter-spacing: 0;">
                <input type="checkbox" name="_remember_me" style="accent-color: #6366f1;">
                Se souvenir de moi
            </label>
        </div>

        <button type="submit" class="btn btn-primary w-full btn-lg" style="justify-content: center;">
            <i class="fas fa-sign-in-alt"></i>
            Se connecter
        </button>
    </form>

    <div class="auth-link">
        Pas encore de compte ? <a href="{{ path('app_register') }}">Créer un compte</a>
    </div>
</div>

<script>
function togglePassword(id) {
    const input = document.getElementById(id);
    const icon = document.getElementById('toggleIcon');
    if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'fas fa-eye-slash';
    } else {
        input.type = 'password';
        icon.className = 'fas fa-eye';
    }
}

// Focus animation
document.querySelectorAll('input').forEach(input => {
    input.addEventListener('focus', () => input.style.borderColor = '#6366f1');
    input.addEventListener('blur', () => input.style.borderColor = '#2d3a4f');
});
</script>
{% endblock %}
