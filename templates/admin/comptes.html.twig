{% extends 'base.html.twig' %}
{% block title %}Admin — Comptes{% endblock %}

{% block body %}
<div class="admin-header">
    <div class="page-header" style="margin-bottom: 0;">
        <div>
            <h1 class="page-title"><i class="fas fa-university"></i> Gestion des Comptes</h1>
            <p class="page-subtitle">{{ comptes|length }} compte{{ comptes|length > 1 ? 's' : '' }}</p>
        </div>
    </div>
</div>

<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>Titulaire</th>
                <th>IBAN</th>
                <th>Type</th>
                <th>Solde</th>
                <th>Statut</th>
                <th>Créé le</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for compte in comptes %}
        <tr>
            <td>
                <a href="{{ path('admin_client_show', {id: compte.user.id}) }}" style="text-decoration: none; color: #f8fafc; font-weight: 600; font-size: 14px;">
                    {{ compte.user.fullName }}
                </a>
            </td>
            <td style="font-family: 'Space Mono', monospace; font-size: 11px; color: #64748b;">{{ compte.iban }}</td>
            <td>
                <span style="background: rgba(99,102,241,0.15); color: #818cf8; padding: 3px 10px; border-radius: 20px; font-size: 12px; font-weight: 600;">
                    {{ compte.typeLabel }}
                </span>
            </td>
            <td style="font-family: 'Space Mono', monospace; font-size: 14px; font-weight: 700; color: {{ compte.soldeFloat >= 0 ? '#6ee7b7' : '#fca5a5' }};">
                {{ compte.soldeFloat|number_format(2, ',', ' ') }} €
            </td>
            <td>
                <span class="status-badge {{ compte.isActif ? 'status-actif' : 'status-bloque' }}">
                    <i class="fas fa-{{ compte.isActif ? 'check-circle' : 'lock' }}"></i>
                    {{ compte.isActif ? 'Actif' : 'Bloqué' }}
                </span>
            </td>
            <td style="font-size: 13px; color: #64748b;">{{ compte.createdAt|date('d/m/Y') }}</td>
            <td>
                <div style="display: flex; gap: 6px;">
                    <form method="post" action="{{ path('admin_compte_toggle', {id: compte.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_compte_' ~ compte.id) }}">
                        <button type="submit" class="btn btn-sm {{ compte.isActif ? 'btn-danger' : 'btn-success' }}">
                            <i class="fas fa-{{ compte.isActif ? 'lock' : 'unlock' }}"></i>
                            {{ compte.isActif ? 'Bloquer' : 'Débloquer' }}
                        </button>
                    </form>
                    <a href="{{ path('admin_compte_transactions', {id: compte.id}) }}" class="btn btn-outline btn-sm">
                        <i class="fas fa-history"></i>
                    </a>
                </div>
            </td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
