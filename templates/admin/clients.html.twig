{% extends 'base.html.twig' %}
{% block title %}Admin — Clients{% endblock %}

{% block body %}
<div class="admin-header">
    <div class="page-header" style="margin-bottom: 0;">
        <div>
            <h1 class="page-title"><i class="fas fa-users"></i> Gestion des Clients</h1>
            <p class="page-subtitle">{{ clients|length }} client{{ clients|length > 1 ? 's' : '' }}</p>
        </div>
    </div>
</div>

<form method="get" action="{{ path('admin_clients') }}" class="search-box">
    <input type="text" name="search" value="{{ search }}" placeholder="🔍 Rechercher par nom, email...">
    <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Chercher</button>
    {% if search %}<a href="{{ path('admin_clients') }}" class="btn btn-outline"><i class="fas fa-times"></i></a>{% endif %}
</form>

{% if clients is empty %}
<div class="empty-state empty-state-card">
    <div class="empty-icon"><i class="fas fa-users"></i></div>
    <div class="empty-title">Aucun client trouvé</div>
</div>
{% else %}
<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>Client</th>
                <th>Email</th>
                <th>Téléphone</th>
                <th>Comptes</th>
                <th>Inscrit le</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for client in clients %}
        <tr>
            <td>
                <div class="user-inline">
                    <div class="user-inline-avatar">
                        {{ client.prenom|first|upper }}{{ client.nom|first|upper }}
                    </div>
                    <span class="user-inline-name">{{ client.fullName }}</span>
                </div>
            </td>
            <td class="muted-cell">{{ client.email }}</td>
            <td class="muted-cell">{{ client.telephone ?? '—' }}</td>
            <td>
                <span class="count-badge">{{ client.comptesBancaires|length }}</span>
            </td>
            <td class="muted-cell">{{ client.createdAt|date('d/m/Y') }}</td>
            <td>
                <div style="display: flex; gap: 6px;">
                    <a href="{{ path('admin_client_show', {id: client.id}) }}" class="btn btn-outline btn-sm" title="Voir">
                        <i class="fas fa-eye"></i>
                    </a>
                    <a href="{{ path('admin_client_edit', {id: client.id}) }}" class="btn btn-outline btn-sm" title="Modifier">
                        <i class="fas fa-edit"></i>
                    </a>
                    <form method="post" action="{{ path('admin_client_delete', {id: client.id}) }}"
                          onsubmit="return confirm('Supprimer le client {{ client.fullName|e('js') }} ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ client.id) }}">
                        <button type="submit" class="btn btn-danger btn-sm" title="Supprimer">
                            <i class="fas fa-trash"></i>
                        </button>
                    </form>
                </div>
            </td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}
{% endblock %}
