{% extends 'base.html.twig' %}
{% block title %}Transactions — {{ compte.iban }}{% endblock %}

{% block body %}
<div class="admin-header">
    <div class="page-header" style="margin-bottom: 0;">
        <div>
            <a href="{{ path('admin_comptes') }}" class="back-link">
                <i class="fas fa-arrow-left"></i> Comptes
            </a>
            <h1 class="page-title" style="margin-top: 8px;">Transactions — {{ compte.typeLabel }}</h1>
            <p class="page-subtitle">{{ compte.iban }} · {{ compte.user.fullName }}</p>
        </div>
    </div>
</div>

<div class="stats-grid" style="margin-bottom: 24px;">
    <div class="stat-card" style="--accent-color: var(--iris);">
        <div class="stat-icon"><i class="fas fa-euro-sign"></i></div>
        <div class="stat-value">{{ compte.soldeFloat|number_format(2, ',', ' ') }} €</div>
        <div class="stat-label">Solde actuel</div>
    </div>
    <div class="stat-card stat-card-success" style="--accent-color: var(--green);">
        <div class="stat-icon"><i class="fas fa-list"></i></div>
        <div class="stat-value">{{ transactions|length }}</div>
        <div class="stat-label">Transactions</div>
    </div>
</div>

{% if transactions is empty %}
<div class="empty-state empty-state-card">
    <div class="empty-text" style="margin-bottom: 0;">Aucune transaction</div>
</div>
{% else %}
<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>Type</th>
                <th>Libellé</th>
                <th>Montant</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
        {% for tx in transactions %}
        <tr>
            <td>
                <div style="display: flex; align-items: center; gap: 10px;">
                    <div class="tx-icon {{ tx.isCredit ? 'credit' : 'debit' }}" style="width: 34px; height: 34px; font-size: 14px;">
                        <i class="fas fa-{% if tx.type == 'depot' %}arrow-down{% elseif tx.type == 'retrait' %}arrow-up{% else %}exchange-alt{% endif %}"></i>
                    </div>
                    <span style="font-size: 13px; font-weight: 600;" class="{{ tx.isCredit ? 'amount-credit' : 'amount-debit' }}">{{ tx.typeLabel }}</span>
                </div>
            </td>
            <td class="muted-cell">{{ tx.libelle ?? '—' }}</td>
            <td class="{{ tx.isCredit ? 'amount-credit' : 'amount-debit' }}">
                {{ tx.isCredit ? '+' : '-' }}{{ tx.montantFloat|number_format(2, ',', ' ') }} €
            </td>
            <td style="font-size: 13px; color: var(--text-3);">{{ tx.createdAt|date('d/m/Y à H:i') }}</td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}
{% endblock %}
