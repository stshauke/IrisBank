{% extends 'base.html.twig' %}
{% block title %}Admin — Dashboard{% endblock %}

{% block body %}
<div class="admin-header">
    <div class="page-header admin-page-header">
        <div>
            <h1 class="page-title admin-page-title">
                <i class="fas fa-shield-alt"></i>
                Dashboard Administration
            </h1>
            <p class="page-subtitle">{{ todayLabel }} — Vue globale du système IrisBank</p>
        </div>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card" style="--accent-color: var(--iris);">
        <div class="stat-icon"><i class="fas fa-users"></i></div>
        <div class="stat-value">{{ totalClients }}</div>
        <div class="stat-label">Clients enregistrés</div>
    </div>

    <div class="stat-card stat-card-success" style="--accent-color: var(--green);">
        <div class="stat-icon"><i class="fas fa-university"></i></div>
        <div class="stat-value">{{ totalComptes }}</div>
        <div class="stat-label">Comptes bancaires</div>
    </div>

    <div class="stat-card stat-card-warning" style="--accent-color: var(--gold);">
        <div class="stat-icon"><i class="fas fa-euro-sign"></i></div>
        <div class="stat-value">{{ totalDepots|number_format(0, ',', ' ') }} €</div>
        <div class="stat-label">Total des dépôts</div>
    </div>

    <div class="stat-card stat-card-danger" style="--accent-color: var(--red);">
        <div class="stat-icon"><i class="fas fa-lock"></i></div>
        <div class="stat-value">{{ comptesBloques }}</div>
        <div class="stat-label">Comptes bloqués</div>
    </div>
</div>

<div class="admin-dashboard-grid">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Derniers clients inscrits</h3>
            <a href="{{ path('admin_clients') }}" class="btn btn-outline btn-sm">Tous les clients</a>
        </div>

        {% if recentUsers is empty %}
            <div class="empty-state empty-state-compact">
                <div class="empty-text empty-text-no-margin">Aucun client</div>
            </div>
        {% else %}
            <div class="table-container table-plain">
                <table>
                    <thead>
                        <tr>
                            <th>Client</th>
                            <th>Email</th>
                            <th>Inscrit</th>
                            <th>Comptes</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for client in recentUsers %}
                        <tr>
                            <td>
                                <div class="user-inline">
                                    <div class="user-inline-avatar">
                                        {{ client.prenom|first|upper }}{{ client.nom|first|upper }}
                                    </div>
                                    <span class="user-inline-name">{{ client.fullName }}</span>
                                </div>
                            </td>
                            <td class="muted-cell">{{ client.email }}</td>
                            <td class="muted-cell">{{ client.createdAt|date('d/m/Y') }}</td>
                            <td>
                                <span class="count-badge">
                                    {{ client.comptesBancaires|length }}
                                </span>
                            </td>
                            <td>
                                <a href="{{ path('admin_client_show', {id: client.id}) }}" class="btn btn-outline btn-sm">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

    <div class="admin-side-stack">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Actions rapides</h3>
            </div>
            <div class="quick-links">
                <a href="{{ path('admin_clients') }}" class="btn btn-outline quick-link">
                    <i class="fas fa-users quick-link-icon quick-link-icon-iris"></i> Gérer les clients
                </a>
                <a href="{{ path('admin_comptes') }}" class="btn btn-outline quick-link">
                    <i class="fas fa-university quick-link-icon quick-link-icon-green"></i> Gérer les comptes
                </a>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Transactions récentes</h3>
            </div>

            {% if recentTransactions is empty %}
                <div class="empty-state empty-state-compact">
                    <div class="empty-text empty-text-no-margin">Aucune transaction récente</div>
                </div>
            {% else %}
                {% for tx in recentTransactions %}
                    <div class="tx-item">
                        <div class="tx-icon {{ tx.isCredit ? 'credit' : 'debit' }}">
                            <i class="fas fa-{% if tx.type == 'depot' %}arrow-down{% elseif tx.type == 'retrait' %}arrow-up{% else %}exchange-alt{% endif %}"></i>
                        </div>
                        <div class="tx-info">
                            <div class="tx-label">{{ tx.libelle ?? tx.typeLabel }}</div>
                            <div class="tx-date">{{ tx.createdAt|date('d/m/Y à H:i') }}</div>
                        </div>
                        <div class="tx-amount {{ tx.isCredit ? 'amount-credit' : 'amount-debit' }}">
                            {{ tx.montantFloat|number_format(2, ',', ' ') }} €
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}