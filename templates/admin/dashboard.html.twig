{% extends 'base.html.twig' %}
{% block title %}Admin — Dashboard{% endblock %}

{% block body %}
<div class="admin-header">
    <div class="page-header" style="margin-bottom: 0;">
        <div>
            <h1 class="page-title">
                <i class="fas fa-shield-alt" style="font-size: 22px;"></i> Dashboard Administration
            </h1>
            <p class="page-subtitle">Vue globale du système IrisBank</p>
        </div>
    </div>
</div>

{# STATS #}
<div class="stats-grid">
    <div class="stat-card" style="--accent-color: #6366f1;">
        <div class="stat-icon"><i class="fas fa-users"></i></div>
        <div class="stat-value">{{ totalClients }}</div>
        <div class="stat-label">Clients enregistrés</div>
    </div>
    <div class="stat-card" style="--accent-color: #10b981;">
        <div class="stat-icon" style="background: rgba(16,185,129,0.15); color: #6ee7b7;"><i class="fas fa-university"></i></div>
        <div class="stat-value">{{ totalComptes }}</div>
        <div class="stat-label">Comptes bancaires</div>
    </div>
    <div class="stat-card" style="--accent-color: #f59e0b;">
        <div class="stat-icon" style="background: rgba(245,158,11,0.15); color: #fcd34d;"><i class="fas fa-euro-sign"></i></div>
        <div class="stat-value">{{ totalDepots|number_format(0, ',', ' ') }} €</div>
        <div class="stat-label">Total des dépôts</div>
    </div>
</div>

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; align-items: start;">
    {# RECENT CLIENTS #}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Derniers clients inscrits</h3>
            <a href="{{ path('admin_clients') }}" class="btn btn-outline btn-sm">Tous les clients</a>
        </div>
        {% if recentUsers is empty %}
        <div class="empty-state" style="padding: 32px;"><div class="empty-text" style="margin-bottom: 0;">Aucun client</div></div>
        {% else %}
        <table style="width: 100%;">
            <thead>
                <tr>
                    <th>Client</th>
                    <th>Email</th>
                    <th>Inscrit le</th>
                    <th>Comptes</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            {% for client in recentUsers %}
            <tr>
                <td>
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <div style="width: 36px; height: 36px; background: linear-gradient(135deg, #6366f1, #4338ca); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; flex-shrink: 0;">
                            {{ client.prenom|first|upper }}{{ client.nom|first|upper }}
                        </div>
                        <span style="font-weight: 600; font-size: 14px;">{{ client.fullName }}</span>
                    </div>
                </td>
                <td style="font-size: 13px; color: #64748b;">{{ client.email }}</td>
                <td style="font-size: 13px; color: #64748b;">{{ client.createdAt|date('d/m/Y') }}</td>
                <td>
                    <span style="background: rgba(99,102,241,0.15); color: #818cf8; padding: 3px 10px; border-radius: 20px; font-size: 12px; font-weight: 600;">
                        {{ client.comptesBancaires|length }}
                    </span>
                </td>
                <td>
                    <a href="{{ path('admin_client_show', {id: client.id}) }}" class="btn btn-outline btn-sm">
                        <i class="fas fa-eye"></i>
                    </a>
                </td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
        {% endif %}
    </div>

    {# QUICK ACTIONS #}
    <div class="card">
        <div class="card-header"><h3 class="card-title">Actions rapides</h3></div>
        <div style="display: flex; flex-direction: column; gap: 10px;">
            <a href="{{ path('admin_clients') }}" class="btn btn-outline" style="justify-content: flex-start;">
                <i class="fas fa-users" style="color: #6366f1;"></i> Gérer les clients
            </a>
            <a href="{{ path('admin_comptes') }}" class="btn btn-outline" style="justify-content: flex-start;">
                <i class="fas fa-university" style="color: #10b981;"></i> Gérer les comptes
            </a>
        </div>
    </div>
</div>
{% endblock %}
