{% extends 'base.html.twig' %}
{% block title %}Client — {{ client.fullName }}{% endblock %}

{% block body %}
<div class="admin-header">
    <div class="page-header" style="margin-bottom: 0;">
        <div>
            <a href="{{ path('admin_clients') }}" style="color: #94a3b8; text-decoration: none; font-size: 14px;">
                <i class="fas fa-arrow-left"></i> Clients
            </a>
            <h1 class="page-title" style="margin-top: 8px;">{{ client.fullName }}</h1>
        </div>
        <div style="display: flex; gap: 10px;">
            <a href="{{ path('admin_client_edit', {id: client.id}) }}" class="btn btn-warning">
                <i class="fas fa-edit"></i> Modifier
            </a>
            <form method="post" action="{{ path('admin_client_delete', {id: client.id}) }}" 
                  onsubmit="return confirm('Supprimer définitivement ce client ?')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ client.id) }}">
                <button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> Supprimer</button>
            </form>
        </div>
    </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 2fr; gap: 24px; align-items: start;">
    <div class="card">
        <div style="text-align: center; padding: 16px 0 24px;">
            <div style="width: 72px; height: 72px; background: linear-gradient(135deg, #6366f1, #4338ca); border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: 800; margin: 0 auto 16px;">
                {{ client.prenom|first|upper }}{{ client.nom|first|upper }}
            </div>
            <div style="font-size: 18px; font-weight: 700;">{{ client.fullName }}</div>
        </div>
        <table style="width: 100%;">
            <tr style="border-bottom: 1px solid #1e293b;"><td style="padding: 10px 0; font-size: 12px; color: #64748b; text-transform: uppercase;">Email</td><td style="padding: 10px 0; font-size: 13px; text-align: right;">{{ client.email }}</td></tr>
            <tr style="border-bottom: 1px solid #1e293b;"><td style="padding: 10px 0; font-size: 12px; color: #64748b; text-transform: uppercase;">Téléphone</td><td style="padding: 10px 0; font-size: 13px; text-align: right;">{{ client.telephone ?? '—' }}</td></tr>
            <tr style="border-bottom: 1px solid #1e293b;"><td style="padding: 10px 0; font-size: 12px; color: #64748b; text-transform: uppercase;">Adresse</td><td style="padding: 10px 0; font-size: 13px; text-align: right;">{{ client.adresse ?? '—' }}</td></tr>
            <tr style="border-bottom: 1px solid #1e293b;"><td style="padding: 10px 0; font-size: 12px; color: #64748b; text-transform: uppercase;">Naissance</td><td style="padding: 10px 0; font-size: 13px; text-align: right;">{{ client.dateNaissance ? client.dateNaissance|date('d/m/Y') : '—' }}</td></tr>
            <tr><td style="padding: 10px 0; font-size: 12px; color: #64748b; text-transform: uppercase;">Inscrit le</td><td style="padding: 10px 0; font-size: 13px; text-align: right;">{{ client.createdAt|date('d/m/Y') }}</td></tr>
        </table>
    </div>

    <div>
        <div class="card-header" style="margin-bottom: 16px;">
            <h3 class="card-title">Comptes bancaires ({{ client.comptesBancaires|length }})</h3>
        </div>
        {% if client.comptesBancaires is empty %}
        <div class="empty-state" style="background: #111827; border: 1px solid #1e293b; border-radius: 16px; padding: 32px;">
            <div class="empty-text" style="margin-bottom: 0;">Aucun compte</div>
        </div>
        {% else %}
        <div class="comptes-grid">
        {% for compte in client.comptesBancaires %}
        <div class="compte-card {{ compte.type }}" style="position: relative;">
            <span class="status-badge {{ compte.isActif ? 'status-actif' : 'status-bloque' }}" style="position: absolute; top: 16px; right: 16px;">
                <i class="fas fa-{{ compte.isActif ? 'check' : 'lock' }}"></i>
                {{ compte.isActif ? 'Actif' : 'Bloqué' }}
            </span>
            <div class="badge"><i class="fas fa-credit-card"></i> {{ compte.typeLabel }}</div>
            <div class="compte-solde">{{ compte.soldeFloat|number_format(2, ',', ' ') }} €</div>
            <div class="compte-iban">{{ compte.iban }}</div>
            <div class="compte-actions">
                <form method="post" action="{{ path('admin_compte_toggle', {id: compte.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_compte_' ~ compte.id) }}">
                    <button type="submit" class="btn btn-sm {{ compte.isActif ? 'btn-danger' : 'btn-success' }}">
                        <i class="fas fa-{{ compte.isActif ? 'lock' : 'unlock' }}"></i>
                        {{ compte.isActif ? 'Bloquer' : 'Débloquer' }}
                    </button>
                </form>
                <a href="{{ path('admin_compte_transactions', {id: compte.id}) }}" class="btn btn-outline btn-sm">
                    <i class="fas fa-history"></i> Transactions
                </a>
            </div>
        </div>
        {% endfor %}
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
