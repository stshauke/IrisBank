{% extends 'base.html.twig' %}
{% block title %}Mon Profil{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1 class="page-title">Mon Profil</h1>
        <p class="page-subtitle">Gérez vos informations personnelles</p>
    </div>
</div>

<div class="profile-layout">
    <div>
        <div class="card profile-card">
            <div class="profile-avatar">
                {{ user.prenom|first|upper }}{{ user.nom|first|upper }}
            </div>
            <div class="profile-name">{{ user.fullName }}</div>
            <div class="profile-email">{{ user.email }}</div>
            <div class="profile-badge-mt">
                {% if is_granted('ROLE_ADMIN') %}
                <span class="status-badge status-badge-admin">
                    <i class="fas fa-crown"></i> Administrateur
                </span>
                {% else %}
                <span class="status-badge status-actif"><i class="fas fa-user"></i> Client</span>
                {% endif %}
            </div>
            <div class="profile-since">Membre depuis {{ user.createdAt|date('d/m/Y') }}</div>
        </div>

        <div class="card" style="margin-top: 16px;">
            <a href="{{ path('app_profil_password') }}" class="btn btn-outline w-full" style="justify-content: center;">
                <i class="fas fa-lock"></i> Changer le mot de passe
            </a>
        </div>
    </div>

    <div class="form-wrapper">
        <h3 class="form-section-title">
            <i class="fas fa-user-edit"></i> Informations personnelles
        </h3>

        {{ form_start(form) }}

        <div class="form-row">
            <div class="form-group">
                {{ form_label(form.nom) }}
                {{ form_widget(form.nom, {attr: {class: 'ib-input'}}) }}
                {{ form_errors(form.nom) }}
            </div>
            <div class="form-group">
                {{ form_label(form.prenom) }}
                {{ form_widget(form.prenom, {attr: {class: 'ib-input'}}) }}
                {{ form_errors(form.prenom) }}
            </div>
        </div>

        <div class="form-group">
            {{ form_label(form.email) }}
            {{ form_widget(form.email, {attr: {class: 'ib-input'}}) }}
            {{ form_errors(form.email) }}
        </div>

        <div class="form-row">
            <div class="form-group">
                {{ form_label(form.telephone) }}
                {{ form_widget(form.telephone, {attr: {class: 'ib-input'}}) }}
                {{ form_errors(form.telephone) }}
            </div>
            <div class="form-group">
                {{ form_label(form.dateNaissance) }}
                {{ form_widget(form.dateNaissance, {attr: {class: 'ib-input'}}) }}
                {{ form_errors(form.dateNaissance) }}
            </div>
        </div>

        <div class="form-group">
            {{ form_label(form.adresse) }}
            {{ form_widget(form.adresse, {attr: {class: 'ib-input'}}) }}
            {{ form_errors(form.adresse) }}
        </div>

        <button type="submit" class="btn btn-primary btn-lg w-full" style="justify-content: center;">
            <i class="fas fa-save"></i> Enregistrer les modifications
        </button>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
