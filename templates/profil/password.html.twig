{% extends 'base.html.twig' %}
{% block title %}Changer le mot de passe{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <a href="{{ path('app_profil') }}" style="color: #94a3b8; text-decoration: none; font-size: 14px;">
            <i class="fas fa-arrow-left"></i> Mon profil
        </a>
        <h1 class="page-title" style="margin-top: 8px;">Changer le mot de passe</h1>
    </div>
</div>

<div class="form-wrapper" style="max-width: 480px;">
    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px; padding-bottom: 20px; border-bottom: 1px solid #1e293b;">
        <div style="width: 48px; height: 48px; background: rgba(99,102,241,0.15); border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 22px; color: #818cf8;">
            <i class="fas fa-lock"></i>
        </div>
        <div>
            <div style="font-size: 16px; font-weight: 700;">Sécurité du compte</div>
            <div style="font-size: 13px; color: #64748b;">Min. 8 caractères, 1 majuscule, 1 chiffre</div>
        </div>
    </div>

    {{ form_start(form) }}

    <div class="form-group">
        {{ form_label(form.currentPassword) }}
        {{ form_widget(form.currentPassword, {attr: {class: 'ib-input'}}) }}
        {{ form_errors(form.currentPassword) }}
    </div>

    <div class="divider"></div>

    <div class="form-group">
        {{ form_label(form.newPassword.first) }}
        {{ form_widget(form.newPassword.first, {attr: {class: 'ib-input'}}) }}
        {{ form_errors(form.newPassword.first) }}
    </div>

    <div class="form-group">
        {{ form_label(form.newPassword.second) }}
        {{ form_widget(form.newPassword.second, {attr: {class: 'ib-input'}}) }}
        {{ form_errors(form.newPassword.second) }}
    </div>

    <button type="submit" class="btn btn-primary btn-lg w-full" style="justify-content: center;">
        <i class="fas fa-shield-alt"></i> Mettre à jour le mot de passe
    </button>

    {{ form_end(form) }}
</div>

<style>
.ib-input { width: 100%; background: #1a2235; border: 1px solid #2d3a4f; border-radius: 10px; padding: 12px 16px; color: #f8fafc; font-family: 'Sora', sans-serif; font-size: 14px; transition: all 0.25s ease; }
.ib-input:focus { outline: none; border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,0.15); }
</style>
{% endblock %}
